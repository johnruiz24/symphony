{
  "name": "symphony-e2e-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "test:perf": "tsx scripts/perf-benchmark.ts",
    "test:report": "playwright show-report",
    "dynamodb:start": "bash scripts/dynamodb-local.sh start",
    "dynamodb:stop": "bash scripts/dynamodb-local.sh stop"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
